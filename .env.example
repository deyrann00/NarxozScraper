# Copy to .env and fill in; .env is never committed.
# LLM via OpenRouter (https://openrouter.ai/keys): per-mention analysis and the overall summary.
OPENROUTER_API_KEY=
# SMTP login for emailing reports (Gmail: an app password, not the account password).
SMTP_USER=
SMTP_PASS=
# Optional official Threads API token; empty = browser search.
THREADS_ACCESS_TOKEN=
# Instagram / Threads login, only for `narxoz login`.
THREADS_USERNAME=
THREADS_PASSWORD=
