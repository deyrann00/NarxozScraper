# LLM analysis via OpenRouter (https://openrouter.ai/keys). Empty = posts are not analysed.
OPENROUTER_API_KEY=

# Optional official API token.
# https://developers.facebook.com/docs/threads/keyword-search/
THREADS_ACCESS_TOKEN=

# Instagram / Threads login for browser search. Never commit this file.
THREADS_USERNAME=
THREADS_PASSWORD=
